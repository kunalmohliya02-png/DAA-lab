
#include <iostream>
#include <vector>
#include <climits>
using namespace std;

struct Edge {
    int u, v, weight;
};

int main() {
    int V, E;
    cout << "Enter number of vertices and edges: ";
    cin >> V >> E;

    vector<Edge> edges(E);

    cout << "Enter edges (source destination weight):\n";

    for (int i = 0; i < E; i++) {
        cin >> edges[i].u >> edges[i].v >> edges[i].weight;
    }

    int source;
    cout << "Enter source vertex: ";
    cin >> source;

    vector<int> dist(V, INT_MAX);
    dist[source] = 0;

    // Relax all edges V-1 times
    for (int i = 1; i <= V - 1; i++) {

        for (auto edge : edges) {

            int u = edge.u;
            int v = edge.v;
            int weight = edge.weight;

            if (dist[u] != INT_MAX &&
                dist[u] + weight < dist[v]) {

                dist[v] = dist[u] + weight;
            }
        }
    }

    // Check for negative-weight cycle
    bool negativeCycle = false;

    for (auto edge : edges) {

        int u = edge.u;
        int v = edge.v;
        int weight = edge.weight;

        if (dist[u] != INT_MAX &&
            dist[u] + weight < dist[v]) {

            negativeCycle = true;
            break;
        }
    }

    if (negativeCycle) {
        cout << "\nGraph contains a negative-weight cycle.\n";
    }
    else {
        cout << "\nNo negative-weight cycle detected.\n";

        cout << "\nShortest distances from source "
             << source << ":\n";

        for (int i = 0; i < V; i++) {
            cout << source << " -> " << i << " = ";

            if (dist[i] == INT_MAX)
                cout << "INF";
            else
                cout << dist[i];

            cout << endl;
        }
    }

    return 0;
}
